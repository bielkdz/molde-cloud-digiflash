rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function accessPath() { return /databases/$(database)/documents/settings/access; }
    function companyPath(companyId) { return /databases/$(database)/documents/companies/$(companyId); }
    function invitationPath(email) { return /databases/$(database)/documents/companyInvites/$(email); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function currentProfile() { return get(userPath(request.auth.uid)).data; }
    function currentCompany() { return currentProfile().companyId; }
    function isSuperAdmin() { return hasProfile() && currentProfile().role == "superadmin"; }
    function isCompanyAdmin() { return hasProfile() && currentProfile().role == "admin"; }
    function canCreateFolder() {
      return isSuperAdmin() || isCompanyAdmin()
        || !("permissions" in currentProfile())
        || !("createFolder" in currentProfile().permissions)
        || currentProfile().permissions.createFolder == true;
    }
    function canRenameItems() {
      return isSuperAdmin() || isCompanyAdmin()
        || !("permissions" in currentProfile())
        || !("renameItems" in currentProfile().permissions)
        || currentProfile().permissions.renameItems == true;
    }
    function canDeleteItems() {
      return isSuperAdmin() || isCompanyAdmin()
        || !("permissions" in currentProfile())
        || !("deleteItems" in currentProfile().permissions)
        || currentProfile().permissions.deleteItems == true;
    }
    function companyAllowed() {
      return isSuperAdmin()
        || !exists(companyPath(currentCompany()))
        || (get(companyPath(currentCompany())).data.status != "blocked"
          && get(companyPath(currentCompany())).data.status != "deleted");
    }
    function isApproved() {
      return hasProfile()
        && currentProfile().role in ["superadmin", "admin", "user"]
        && companyAllowed();
    }
    function hasInvitation(data) {
      return signedIn()
        && request.auth.token.email is string
        && exists(invitationPath(request.auth.token.email))
        && get(invitationPath(request.auth.token.email)).data.email == request.auth.token.email
        && get(invitationPath(request.auth.token.email)).data.companyId == data.companyId
        && data.role == "pending"
        && data.requestedRole == (get(invitationPath(request.auth.token.email)).data.role == "admin" ? "admin" : "user");
    }
    function sameCompany(data) {
      return isApproved() && "companyId" in data && data.companyId == currentCompany();
    }
    function legacyOwned(data) {
      return isApproved() && !("companyId" in data) && data.userId == request.auth.uid;
    }
    function validCompanyWrite(data) {
      return isApproved() && data.companyId == currentCompany() && data.userId == request.auth.uid;
    }
    function isLegacyMigration() {
      return legacyOwned(resource.data)
        && request.resource.data.companyId == currentCompany()
        && request.resource.data.userId == request.auth.uid;
    }
    function tenantIdentityUnchanged() {
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data.userId == resource.data.userId;
    }
    function isInitialOwnerClaim(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email == "bielcosta3101@gmail.com"
        && request.auth.token.email_verified == true
        && !exists(accessPath())
        && getAfter(accessPath()).data.ownerUid == uid
        && getAfter(accessPath()).data.ownerEmail == "bielcosta3101@gmail.com"
        && request.resource.data.role == "superadmin"
        && request.resource.data.companyId == "rosa-atelie";
    }
    function isOwner(uid) {
      return exists(accessPath()) && get(accessPath()).data.ownerUid == uid;
    }

    match /settings/access {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email == "bielcosta3101@gmail.com"
        && request.auth.token.email_verified == true
        && !exists(accessPath())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == "bielcosta3101@gmail.com";
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (isCompanyAdmin() && "companyId" in resource.data && resource.data.companyId == currentCompany())
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          (request.resource.data.companyId == "rosa-atelie" && request.resource.data.role == "pending")
          || isInitialOwnerClaim(uid)
          || hasInvitation(request.resource.data)
        );
      allow update: if isInitialOwnerClaim(uid)
        || (isSuperAdmin()
          && (
            (isOwner(uid) && request.resource.data.role == "superadmin")
            || (!isOwner(uid) && request.resource.data.role != "superadmin")
          ))
        || (isCompanyAdmin()
          && !isOwner(uid)
          && "companyId" in resource.data
          && resource.data.companyId == currentCompany()
          && request.resource.data.companyId == currentCompany()
          && request.resource.data.role != "superadmin")
        || (signedIn()
          && request.auth.uid == uid
          && (
            (request.resource.data.role == resource.data.role
              && request.resource.data.companyId == ("companyId" in resource.data ? resource.data.companyId : "rosa-atelie")
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "name", "email", "photoURL", "lastLogin"
              ]))
            || (isOwner(uid)
              && request.resource.data.role == "superadmin"
              && request.resource.data.companyId == "rosa-atelie")
            || hasInvitation(request.resource.data)
          ));
      allow delete: if (isSuperAdmin() || isCompanyAdmin())
        && !isOwner(uid)
        && "companyId" in resource.data
        && (isSuperAdmin() || resource.data.companyId == currentCompany());
    }

    match /companies/{companyId} {
      allow read: if isSuperAdmin()
        || (hasProfile() && companyId == currentCompany())
        || (signedIn()
          && request.auth.token.email is string
          && resource.data.adminEmail == request.auth.token.email);
      allow create: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.adminEmail is string
        && request.resource.data.status == "active";
      allow update: if isSuperAdmin()
        || (isCompanyAdmin()
          && companyId == currentCompany()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["oneDriveAccount", "updatedAt"])
          && request.resource.data.oneDriveAccount is string);
      allow delete: if isSuperAdmin();
    }

    match /companyInvites/{email} {
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.token.email == email)
        || (isCompanyAdmin() && resource.data.companyId == currentCompany());
      allow create: if isSuperAdmin()
        || (isCompanyAdmin()
          && request.resource.data.email == email
          && request.resource.data.companyId == currentCompany()
          && request.resource.data.role == "pending");
      allow delete: if isSuperAdmin()
        || (isCompanyAdmin() && resource.data.companyId == currentCompany());
      allow update: if isSuperAdmin()
        || (signedIn()
          && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimedBy", "claimedAt"])
          && request.resource.data.claimedBy == request.auth.uid);
    }

    match /history/{itemId} {
      allow create: if validCompanyWrite(request.resource.data);
      allow read: if sameCompany(resource.data) || legacyOwned(resource.data);
      allow update: if isLegacyMigration();
      allow delete: if false;
    }

    match /errorLogs/{itemId} {
      allow create: if validCompanyWrite(request.resource.data)
        && request.resource.data.keys().hasOnly([
          "companyId", "userId", "actorName", "operation", "code", "status", "createdAt"
        ])
        && request.resource.data.operation is string
        && request.resource.data.code is string
        && request.resource.data.status == "pending";
      allow read: if isSuperAdmin()
        || (isCompanyAdmin() && sameCompany(resource.data));
      allow update: if (isSuperAdmin() || (isCompanyAdmin() && sameCompany(resource.data)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "resolvedAt", "resolvedBy"
        ])
        && request.resource.data.status == "resolved"
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    match /folders/{folderId} {
      allow create: if validCompanyWrite(request.resource.data) && canCreateFolder();
      allow read: if sameCompany(resource.data) || legacyOwned(resource.data);
      allow update: if isLegacyMigration()
        || (sameCompany(resource.data)
          && request.resource.data.companyId == currentCompany()
          && tenantIdentityUnchanged()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["name"]) || canRenameItems())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["deletedAt", "deletedByName"]) || canDeleteItems()));
      allow delete: if (sameCompany(resource.data) || legacyOwned(resource.data)) && canDeleteItems();
    }

    match /files/{fileId} {
      allow create: if validCompanyWrite(request.resource.data);
      allow read: if sameCompany(resource.data) || legacyOwned(resource.data);
      allow update: if isLegacyMigration()
        || (sameCompany(resource.data)
          && request.resource.data.companyId == currentCompany()
          && tenantIdentityUnchanged()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["name"]) || canRenameItems())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["deletedAt", "deletedByName", "deletedWithFolderId"]) || canDeleteItems()));
      allow delete: if (sameCompany(resource.data) || legacyOwned(resource.data)) && canDeleteItems();
    }
  }
}
